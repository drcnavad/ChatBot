# Copy this file to .env and fill in your own values. Never commit .env (it is in .gitignore).

# Alpaca market data (daily bars) - used by main_signal_analysis.ipynb / run_all.py
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# Alpaca PAPER account (read-only view: alpaca_paper_account.ipynb, alpaca_paper.py, run_all.py --sync-paper)
# Keys from https://app.alpaca.markets -> Paper Trading -> API keys. Only https://paper-api.alpaca.markets/v2 is used.
ALPACA_PAPER_KEY_ID=
ALPACA_PAPER_SECRET_KEY=

# Fundamentals (company_report_autofetch.py, free tier 25 calls/day)
ALPHAVANTAGE_API_KEY=

# News sentiment (sentiment_analysis.ipynb) and earnings dates (earnings_date.ipynb)
NEWS_API_KEY=
FINNHUB_API_KEY=

# Optional
FMP_API_KEY=
SIMFIN_API_KEY=
HF_TOKEN=
TELEGRAM_BOT_TOKEN=
