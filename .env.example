# Copy this file to .env and fill in your own values. Never commit .env (it is in .gitignore).

# Alpaca LIVE account (REAL MONEY): market-data bars (main_signal_analysis.ipynb), the evening trade and the
# 9 AM fill check (paper_trade.py), and the read-only account views (alpaca_paper.py). paper_* names are historical.
ALPACA_LIVE_KEY_ID=...
ALPACA_LIVE_SECRET_KEY=...

# Fundamentals (company_report_autofetch.py, free tier 25 calls/day)
ALPHAVANTAGE_API_KEY=...

# News sentiment (sentiment_analysis.ipynb) and earnings dates (earnings_date.ipynb)
NEWS_API_KEY=...
FINNHUB_API_KEY=...

# Optional: LLM diagnosis of failed runs (pipeline_watchdog.py; the first key found is used)
GEMINI_API_KEY=...
GROQ_API_KEY=...
