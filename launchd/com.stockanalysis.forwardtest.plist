<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Forward test: Mon-Fri 3:00 PM CT (the close), and once on wake for a slot missed in sleep. With wait it first sleeps until
     the day's bar is final (3:05 PM CT) and while any run_all.py runs (the Tue/Thu 3:00 PM refresh, a slow 2:30 PM decision
     run; at most 50 min), then fetches fresh daily bars itself (market data only) and saves the strategies' day + one row per
     trading day to Reports/forward_test_daily.csv (the live account's equity, picks and trading cost, read-only GET
     requests; no orders, no pipeline step, no paid API). Idle on weekends / holidays. Installed by launchd/install_schedule.sh. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stockanalysis.forwardtest</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/anaconda3/bin/python</string>
        <string>/Users/drcnavad/Desktop/Stock Analysis/forward_test.py</string>
        <string>--record</string>
        <string>--wait</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/drcnavad/Desktop/Stock Analysis</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/anaconda3/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>0</integer></dict>
    </array>
    <key>StandardOutPath</key>
    <string>/Users/drcnavad/Desktop/Stock Analysis/Reports/logs/launchd_forwardtest.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/drcnavad/Desktop/Stock Analysis/Reports/logs/launchd_forwardtest.err</string>
</dict>
</plist>
