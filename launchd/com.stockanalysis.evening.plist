<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Decision run: Mon-Fri 3:15 PM CT, at login/boot (RunAtLoad), once on wake for a slot missed in sleep, and every
     30 min (StartInterval) as a catch-up net. run_all.py --scheduled does work only when a decision is due: the
     day's decision after 3:15 PM, or a missed one (Mac asleep/off) at the next regular session until the next
     decision slot. Otherwise it prints one "idle:" line. A decision never runs twice (run_state last_decision + lock).
     Installed by launchd/install_schedule.sh. -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stockanalysis.evening</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/anaconda3/bin/python</string>
        <string>/Users/drcnavad/Desktop/Stock Analysis/pipeline_watchdog.py</string>
        <string>--trade</string>
        <string>--scheduled</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/drcnavad/Desktop/Stock Analysis</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/anaconda3/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>15</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>15</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>15</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>15</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>15</integer><key>Minute</key><integer>15</integer></dict>
    </array>
    <key>StartInterval</key>
    <integer>1800</integer>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/drcnavad/Desktop/Stock Analysis/Reports/logs/launchd_evening.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/drcnavad/Desktop/Stock Analysis/Reports/logs/launchd_evening.err</string>
</dict>
</plist>
