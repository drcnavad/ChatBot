<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Morning fill check: Mon-Fri 9:00 AM CT. Completes the previous evening's unfilled orders; nothing to do otherwise.
     Installed by launchd/install_schedule.sh. RunAtLoad = also runs at login/boot, and launchd runs a slot missed
     during sleep once on wake; run_all.py decides whether anything is due (so extra starts are harmless). -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.stockanalysis.morning</string>
    <key>ProgramArguments</key>
    <array>
        <string>/opt/anaconda3/bin/python</string>
        <string>/Users/drcnavad/Desktop/Stock Analysis/pipeline_watchdog.py</string>
        <string>--fill-check</string>
    </array>
    <key>WorkingDirectory</key>
    <string>/Users/drcnavad/Desktop/Stock Analysis</string>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/anaconda3/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>StartCalendarInterval</key>
    <array>
        <dict><key>Weekday</key><integer>1</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>2</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>3</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>4</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
        <dict><key>Weekday</key><integer>5</integer><key>Hour</key><integer>9</integer><key>Minute</key><integer>0</integer></dict>
    </array>
    <key>RunAtLoad</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/drcnavad/Desktop/Stock Analysis/Reports/logs/launchd_morning.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/drcnavad/Desktop/Stock Analysis/Reports/logs/launchd_morning.err</string>
</dict>
</plist>
