# Secrets: API keys live only in .env (never committed)
.env
.env.*
!.env.example
.streamlit/secrets.toml

# Python / Jupyter (notebooks are tracked; nbstripout strips outputs on commit, see .gitattributes)
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.venv/
venv/

# IDE / agent tooling / OS
.vscode/
.idea/
.cursor/
*.swp
.DS_Store

# Everything the pipeline writes is regenerated or is account data: kept local, never committed
Reports/
my_positions.csv
*.log

# Local notes and backups
docs/
*.md
!README.md
*.bak-20*
*Backup*/

# Stock chart: plotly.js is copied in from the installed plotly package at run time; your drawings stay local
dashboard/chart_component/plotly.min.js
data/drawings/

# News read-aloud audio cache (dashboard/news_voice.py)
dashboard/news_voice/audio/

# Dashboard chatbot trading PIN (salted hash only, set with python chatbot/set_pin.py)
.chat_pin.json
.chat_pin.json.tmp

# SQLite database (all former Reports/*.csv tables; see db.py). Account data: kept local, never committed
data/stock_analysis.db
data/stock_analysis.db-*
backups/
